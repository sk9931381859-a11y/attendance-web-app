# Supabase Configuration
# Obtain these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anti-Cheat Kiosk Security (Optional - fallback provided in development)
# Secret key used to sign and verify dynamic 5-second TOTP QR codes
KIOSK_SECRET=your_kiosk_totp_secret_key_here

# Geofencing Edge Function Defaults (Optional - configured in Supabase Edge Functions)
# Latitude and Longitude of the institution/building and acceptable check-in radius (in meters)
BUILDING_LATITUDE=22.8046
BUILDING_LONGITUDE=86.2029
ACCEPTABLE_RADIUS_METERS=100

# Sentry Production Telemetry & Crash Reporting (Optional)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Upstash Redis Rate Limiting
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

